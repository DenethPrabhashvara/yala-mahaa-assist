# Copy to .env next to docker-compose.yml and fill in. Read by docker compose.
DB_NAME=yala-maha-api
DB_USER=postgres
DB_PASSWORD=change-me-long-random

# DNS A records for both must point at the EC2 Elastic IP; Caddy gets HTTPS certificates for them.
FARMER_DOMAIN=farmer.example.com
ADMIN_DOMAIN=admin.example.com
HTTP_PORT=80

# Built into the farmer portal (optional)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
